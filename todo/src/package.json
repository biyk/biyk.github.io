{
  "name": "todo-list-vite-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "rimraf ../assets",
    "build": "npm run clean && vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "test": "npm run test:unit && npm run test:component && npm run test:smoke",
    "test:unit": "vitest run",
    "test:component": "vitest run --config vitest.config.component.js",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.config.smoke.js"
  },
  "dependencies": {
    "element-plus": "^2.9.9",
    "lodash": "^4.17.21",
    "uuid": "^11.1.0",
    "vue": "^3.2.45",
    "vue-router": "^4.5.1",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/test-utils": "^2.4.11",
    "gh-pages": "^5.0.0",
    "happy-dom": "^13.10.1",
    "playwright": "^1.62.1",
    "rimraf": "^6.0.1",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^4.1.0",
    "vitest": "^0.34.6"
  }
}
